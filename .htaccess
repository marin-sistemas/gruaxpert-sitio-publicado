# =====================================================================
# gruaxpert.com.mx · Apache (HostGator)
# Lo copia build.py a dist/ tal cual. Cambios aquí, nunca en dist/.
# =====================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1 · Un solo dominio canónico: https://gruaxpert.com.mx
  #     gruaxpert.com, www y http caen aquí. Si algún día el definitivo
  #     es .com, se invierte esta regla y el canónico de build.py.
  #     La validación del certificado (AutoSSL) entra sin redirigir.
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^gruaxpert\.com\.mx$ [NC]
  RewriteRule ^(.*)$ https://gruaxpert.com.mx/$1 [R=301,L]

  # 1b · 12 nov 2026: «Cómo vendemos» se retiró; vender vive en una sola página.
  RewriteRule ^como-vendemos/?$ /vender-mi-grua/ [R=301,L]

  # 2 · /ruta  →  /ruta/  (las páginas son carpetas con index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 3 · /ruta/index.html → /ruta/
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# 4 · 404 propia
ErrorDocument 404 /404.html

# 5 · Caché: los assets llevan huella de contenido en el nombre (css/js)
#     o son inmutables (fotos, fuentes); el HTML se revalida siempre.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Imágenes de los anuncios (assets/anuncios): el panel de Google Ads las
  # baja desde ads.google.com, por eso se pueden leer desde otro origen.
  <FilesMatch "^gx-anuncio-.*\.jpg$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 6 · Cabeceras de seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 7 · Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# 8 · Tipos
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# php -- BEGIN cPanel-generated handler, do not edit
# Este dominio hereda el paquete “PHP”.
# php -- END cPanel-generated handler, do not edit
